<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="${%Who am I}">
    <l:main-panel>
      <h1>${%Who am I}</h1>
      <j:choose>
        <j:when test="${it.anonymous}">
          <p>${%You are not logged in.}</p>
        </j:when>
        <j:otherwise>
          <p>
            ${%User id}: <b>${it.userId}</b>
          </p>
          <p>${%Authorities resolved at login}:</p>
          <ul>
            <j:forEach var="authority" items="${it.authorities}">
              <li><code>${authority}</code></li>
            </j:forEach>
          </ul>
          <p>
            If a Google Group you belong to is missing here: only direct memberships resolve
            — nested groups never appear — and Google silently omits groups whose membership
            you are not allowed to view. Check the group member-visibility settings, or ask
            an administrator to check the Jenkins log for this login.
          </p>
        </j:otherwise>
      </j:choose>
    </l:main-panel>
  </l:layout>
</j:jelly>
